<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#1c64f2"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
  <title>نظام الصيانة</title>
  <link rel="manifest" href="../manifest.json"/>
  <link rel="stylesheet" href="style.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
  <style>
    body { background: #fff; display: flex; flex-direction: column; min-height: 100vh; }

    .login-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 0 24px;
      padding-top: max(60px, env(safe-area-inset-top, 40px));
      padding-bottom: max(32px, env(safe-area-inset-bottom, 24px));
    }

    .login-brand {
      margin-bottom: 48px;
    }
    .login-icon {
      width: 64px; height: 64px;
      background: var(--primary);
      border-radius: 18px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px;
    }
    .login-icon .ti { font-size: 32px; color: #fff; }
    .login-title { font-size: 26px; font-weight: 700; color: var(--text-1); line-height: 1.2; }
    .login-sub   { font-size: 14px; color: var(--text-3); margin-top: 6px; }

    .login-form { flex: 1; }

    .input-wrap { position: relative; margin-bottom: 14px; }
    .input-icon {
      position: absolute;
      right: 14px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-3);
      font-size: 18px;
      pointer-events: none;
    }
    .input-wrap .form-input { padding-right: 44px; }

    .btn-login {
      width: 100%;
      padding: 15px;
      font-size: 16px;
      border-radius: var(--radius-sm);
      margin-top: 8px;
    }

    .error-msg {
      background: var(--danger-lt);
      color: #991b1b;
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      font-size: 13px;
      margin-bottom: 14px;
      display: none;
      text-align: center;
    }
    .error-msg.show { display: block; }

    .spinner {
      width: 18px; height: 18px;
      border: 2px solid rgba(255,255,255,.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .6s linear infinite;
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .login-footer {
      text-align: center;
      font-size: 12px;
      color: var(--text-3);
      padding-top: 24px;
    }
  </style>
</head>
<body>
<div class="login-wrap">
  <div class="login-brand">
    <div class="login-icon">
      <i class="ti ti-car"></i>
    </div>
    <div class="login-title">نظام متابعة<br/>الصيانة</div>
    <div class="login-sub">هيئة الأمر بالمعروف — جازان</div>
  </div>

  <div class="login-form">
    <div class="error-msg" id="error-msg"></div>

    <div class="form-group">
      <label class="form-label">اسم المستخدم</label>
      <div class="input-wrap">
        <i class="ti ti-user input-icon"></i>
        <input class="form-input" type="text" id="username"
          placeholder="مثال: tech01"
          autocomplete="username"
          autocapitalize="none"
          style="direction:ltr;text-align:right"/>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">كلمة المرور</label>
      <div class="input-wrap">
        <i class="ti ti-lock input-icon"></i>
        <input class="form-input" type="password" id="password"
          placeholder="••••••••"
          autocomplete="current-password"/>
      </div>
    </div>

    <button class="btn btn-primary btn-login" id="login-btn" onclick="doLogin()">
      <span id="btn-text">تسجيل الدخول</span>
      <span class="spinner" id="spinner"></span>
    </button>
  </div>

  <div class="login-footer">
    الإصدار 1.0 — النسخة المحمولة
  </div>
</div>

<script type="module">
import { auth, db } from "../js/firebase.js";
import { signInWithEmailAndPassword, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

const BASE = window.location.pathname.includes("/car-maintenance-system")
  ? "/car-maintenance-system" : "";

const ROLE_PAGES = {
  owner:     BASE + "/mobile/owner.html",
  tech:      BASE + "/mobile/tech.html",
  manager:   BASE + "/mobile/admin.html",
  it:        BASE + "/pages/it.html",
  developer: BASE + "/pages/developer.html",
};

// إذا كان مسجّلاً مسبقاً
onAuthStateChanged(auth, async user => {
  if (!user) return;
  try {
    const snap = await getDoc(doc(db,"users",user.uid));
    if (!snap.exists() || snap.data().frozen) return;
    const role = snap.data().role;
    if (ROLE_PAGES[role]) window.location.replace(ROLE_PAGES[role]);
  } catch {}
});

window.doLogin = async function() {
  const raw  = document.getElementById("username").value.trim().toLowerCase();
  const pass = document.getElementById("password").value;
  const errEl = document.getElementById("error-msg");
  const btn   = document.getElementById("login-btn");
  const txt   = document.getElementById("btn-text");
  const spin  = document.getElementById("spinner");

  errEl.classList.remove("show");
  if (!raw || !pass) {
    errEl.textContent = "يرجى إدخال اسم المستخدم وكلمة المرور";
    errEl.classList.add("show");
    return;
  }

  const email = raw.includes("@") ? raw : raw + "@pv.local";
  btn.disabled = true; txt.style.display = "none"; spin.style.display = "block";

  try {
    const cred = await signInWithEmailAndPassword(auth, email, pass);
    const snap = await getDoc(doc(db,"users",cred.user.uid));

    if (!snap.exists()) throw new Error("no-user");
    const data = snap.data();
    if (data.frozen) throw new Error("frozen");

    window.location.replace(ROLE_PAGES[data.role] || BASE + "/pages/login.html");
  } catch(e) {
    btn.disabled = false; txt.style.display = ""; spin.style.display = "none";
    if (e.message === "frozen") {
      errEl.textContent = "⛔ حسابك موقوف — تواصل مع IT";
    } else if (e.code === "auth/invalid-credential" || e.code === "auth/user-not-found") {
      errEl.textContent = "اسم المستخدم أو كلمة المرور غير صحيحة";
    } else {
      errEl.textContent = "حدث خطأ — حاول مرة أخرى";
    }
    errEl.classList.add("show");
  }
};

document.getElementById("password").addEventListener("keydown", e => {
  if (e.key === "Enter") window.doLogin();
});

// تسجيل Service Worker
if ("serviceWorker" in navigator) {
  navigator.serviceWorker.register(BASE + "/sw.js").catch(() => {});
}
</script>
</body>
</html>
